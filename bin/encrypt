#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  encrypt [options] [file]

Encrypt data with the SSH key stored in 1Password using age.

Options:
  -r, --ref OP_REFERENCE     Override the 1Password secret reference
  -o, --output FILE          Write to FILE (must not already exist)
  -a, --armor                Output ASCII-armored ciphertext
  -d, --decrypt              Decrypt using the same 1Password private key
  -h, --help                 Show this help

With a file, encryption defaults to file.age. Otherwise, read stdin and write
stdout. Decryption writes stdout unless --output is specified. Use -o - to
explicitly write stdout. Options may appear before or after the input file.

Key reference: OP_SSH_ENCRYPT_KEY_REF, then OP_SSH_SIGN_KEY_REF, then
op://token/id_ed25519/private key. Supports Ed25519 and RSA SSH keys.
Requires: op, ssh-keygen, age (brew install age).
USAGE
}

die() {
  printf 'encrypt: %s\n' "$*" >&2
  exit 1
}

key_ref="${OP_SSH_ENCRYPT_KEY_REF:-${OP_SSH_SIGN_KEY_REF:-op://token/id_ed25519/private key}}"
input=""
output=""
decrypt=false
armor=false

while (($#)); do
  case "$1" in
    -r|--ref|-o|--output)
      (($# >= 2)) || die "$1 requires a value"
      [[ -n "$2" ]] || die "$1 requires a non-empty value"
      case "$1" in
        -r|--ref) key_ref="$2" ;;
        *) output="$2" ;;
      esac
      shift 2
      ;;
    -d|--decrypt) decrypt=true; shift ;;
    -a|--armor) armor=true; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    -*) die "unknown option: $1" ;;
    *)
      [[ -z "$input" ]] || die "only one input file is supported"
      input="$1"
      shift
      ;;
  esac
done
if (($#)); then
  [[ -z "$input" && $# == 1 ]] || die "only one input file is supported"
  input="$1"
fi

[[ -n "$key_ref" ]] || die "set --ref or OP_SSH_ENCRYPT_KEY_REF"
if [[ -n "$input" ]]; then
  [[ -f "$input" && -r "$input" ]] || die "input file is not readable: $input"
fi
if $decrypt && $armor; then
  die "--armor cannot be used with --decrypt"
fi
if [[ -z "$output" ]]; then
  if ! $decrypt && [[ -n "$input" ]]; then
    output="${input}.age"
  else
    output="-"
  fi
fi
if [[ "$output" != - && ( -e "$output" || -L "$output" ) ]]; then
  die "output already exists: $output"
fi
for dependency in op ssh-keygen age; do
  command -v "$dependency" >/dev/null 2>&1 || die "$dependency is not installed or not in PATH"
done

umask 077
tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/op-ssh-encrypt.XXXXXXXXXX")"
trap 'rm -rf "$tmpdir"' EXIT
trap 'exit 130' INT
trap 'exit 143' HUP TERM
key_file="$tmpdir/key"
op read --force --out-file "$key_file" "$key_ref" >/dev/null
chmod 600 "$key_file"

if $decrypt; then
  age_args=(--decrypt --identity "$key_file")
else
  recipient="$(ssh-keygen -y -P '' -f "$key_file")"
  case "$recipient" in
    ssh-ed25519\ *|ssh-rsa\ *) ;;
    *) die "only Ed25519 and RSA SSH keys are supported" ;;
  esac
  age_args=(--encrypt --recipient "$recipient")
  if $armor; then age_args+=(--armor); fi
fi

# Stage output so failed encryption or authentication never publishes partial data.
if [[ -n "$input" ]]; then
  age "${age_args[@]}" < "$input" > "$tmpdir/result"
else
  age "${age_args[@]}" > "$tmpdir/result"
fi
if [[ "$output" == - ]]; then
  cat "$tmpdir/result"
else
  (set -o noclobber; cat "$tmpdir/result" > "$output")
fi
