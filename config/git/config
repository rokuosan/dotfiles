[core]
	autocrlf = input
[pull]
	rebase = false
[commit]
	gpgsign = true
[tag]
	gpgSign = true
[gpg]
 	format = ssh
[ghq]
	root = ~/repo
[push]
	autoSetupRemote = true
[alias]
	sw = switch
	st = status
	c = commit
	ch = cherry-pick
[wt]
	basedir = .worktrees
[include]
	path = ~/.config/git-platform
